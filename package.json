{
  "name": "pwa-docenti-backend",
  "private": true,
  "scripts": {
    "db:start": "supabase start",
    "db:reset:local": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --schema public,private --level warning --fail-on warning",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native.ps1",
    "test:supabase:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-supabase-local.ps1"
  },
  "devDependencies": {
    "supabase": "2.121.0"
  }
}
