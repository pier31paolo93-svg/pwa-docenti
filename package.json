{
  "name": "pwa-docenti",
  "private": true,
  "scripts": {
    "db:start": "supabase start",
    "db:reset:local": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --schema public,private --level warning --fail-on warning",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native.ps1",
    "test:supabase:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-supabase-local.ps1",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "playwright test --config playwright.webkit.config.ts",
    "audit:responsive": "node scripts/audit-responsive.cjs after --assert",
    "typecheck": "tsc --noEmit",
    "test:pwa": "node scripts/test-pwa.cjs",
    "format": "prettier --write src tests *.ts index.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supabase": "2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "dexie": "^4.4.6",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.61.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "type": "module",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
